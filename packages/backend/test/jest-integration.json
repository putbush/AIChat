{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "moduleNameMapper": {
    "^@common/(.*)$": "<rootDir>/../src/common/$1",
    "^@features/(.*)$": "<rootDir>/../src/features/$1",
    "^@infra/(.*)$": "<rootDir>/../src/infra/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
